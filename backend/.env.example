# Copy this file to `.env` (in the same directory) and adjust as needed.
# `.env` is gitignored; `.env.example` is committed as the template.
#
# All values here are dev defaults. Override in production.

# Postgres connection. Matches docker-compose.yml — change if you point at a
# different Postgres instance.
DATABASE_URL=postgres://esg:esg_dev_password@localhost:5432/esg_platform

# Django. SECRET_KEY MUST be replaced in any non-dev environment.
DJANGO_SECRET_KEY=dev-only-do-not-use-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
